# Bearer token your apps must send to the proxy. CHANGE THIS.
LITELLM_MASTER_KEY=sk-some-long-string-a-ling

# X-Api-Key for docling-serve (it's tailnet-reachable via Caddy, so it needs auth).
DOCLING_API_KEY=another-long-random-string

# Cloud backup keys — only needed once you uncomment the CLOUD BACKUP block in
# llm-config.yml. Add the key(s) for whichever provider(s) you enable there.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
