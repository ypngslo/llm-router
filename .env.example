# Bearer token your apps must send to the proxy. CHANGE THIS.
LITELLM_MASTER_KEY=sk-some-long-string-a-ling

# X-Api-Key for docling-serve (it's tailnet-reachable via Caddy, so it needs auth).
DOCLING_API_KEY=another-long-random-string

# Cloud failover + explicit cloud models (the OpenRouter entries in llm-config.yml).
OPENROUTER_API_KEY=sk-or-...

# LiteLLM virtual keys / budgets / spend logs — the `litellm` database in the
# shared postgres from ../llm-observability.
DATABASE_URL=postgresql://litellm:password@127.0.0.1:8009/litellm

# Langfuse tracing (../llm-observability). LiteLLM's success/failure callbacks
# no-op gracefully if Langfuse is down, but the keys must exist.
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Only needed for the anthropic/* and openai/* wildcard routes in llm-config.yml.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
